<!DOCTYPE html>
<html lang="en" xmlns="http://www.w3.org/1999/xhtml">
	<head>
		<meta charset="utf-8" />
		<meta name="viewport" content="width=device-width, initial-scale=1.0" />
		<title>Your space at SpaceU is Reserved</title>

		<style type="text/css">
			body {
				margin: 0 !important;
				padding: 0 !important;
				background-color: #f4f4f4;
				font-family: Gilroy;
			}

			table {
				border-collapse: collapse;
			}

			.container {
				max-width: 600px;
				margin: 0 auto;
				background-color: #ffffff;
			}

			.header {
				padding: 20px;
				text-align: center;
			}

			.main-title {
				color: #5a2d0c;
				font-family: Gilroy;
				font-weight: 800;
				font-size: 36px;
				line-height: 120%;
				letter-spacing: 0%;
			}

			.content {
				padding: 20px;
				color: #333333;
			}

			.booking-summary {
				margin-top: 10px;
			}

			.booking-box {
				border: 1px solid #dddddd;
				border-radius: 3px;
				padding: 10px;
				margin-bottom: 10px;
			}

			.footer {
				text-align: center;
				font-size: 14px;
				color: #777777;
				padding: 20px;
			}

			.button-link {
				color: #0066cc;
				text-decoration: none;
			}

			.add-to-calendar {
				display: flex;
				gap: 8px;
				align-items: center;
				margin-top: 8px;
			}

			.add-to-calendar p {
				color: #662300;
				font-family: Inter;
				font-weight: 600;
				font-size: 14px;
				line-height: 135%;
				letter-spacing: 0%;

				margin: 0px;
			}
		</style>
	</head>

