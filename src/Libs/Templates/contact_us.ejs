			<tr>
				<td align="center">
					<!-- Container Table -->
					<table
						class="container"
						width="600"
						border="0"
						cellspacing="0"
						cellpadding="0"
						style="background-color: #ffffff"
					>
						<!-- Header Section -->
						<tr>
							<td class="header" style="padding: 20px; text-align: center">
								<h1 class="main-title">New Message from <%= name %></h1>
							</td>
						</tr>

						<!-- Body / Content Section -->
						<tr>
							<td class="content" style="padding: 20px; color: #333333">
								<p>Dear Space U Admin</p>
								<p>
									You have a new message from <strong><%= name %></strong> (<%= email %>)</p>
								</p>
								<p>Here’s a summary of the message:</p>
								<!-- Booking Summary Section  -->
								<div class="booking-summary" style="margin-top: 10px">
									
									<div
										class="booking-box"
										style="
											border: 1px solid #dddddd;
											border-radius: 8px;
											padding: 10px;
											margin-bottom: 10px;
										"
									>
										<p>Name: <strong> <%= name %> </strong></p>
										<p>Email: <%= email %> </p>
										<p>Message: <%= message %></p>
										
									</div>

									<!-- end map bookings -->
								</div>
								<!-- end booking summary -->
								
								<p>
									Arrive on time to make the most of your session. If you have
									any questions, please let us know. You can reach us on
									<a href="tel:<%= contactPhone %>" style="color: #662300"><%= contactPhone %></a> or email us at
									<a
										href="mailto:<%= contactEmail %>"
										style="color: #662300"
										><%= contactEmail %></a
									>
								</p>

								<p>Best regards</p>
							</td>
						</tr>
					</table>
