<!DOCTYPE html>
<html lang="en">
	<head>
		<meta charset="UTF-8" />
		<meta name="viewport" content="width=device-width, initial-scale=1.0" />
		<title>SpaceU Booking Confirmation</title>
		<style>
			@media only screen and (max-width: 600px) {
				.container {
					width: 100% !important;
					padding: 10px !important;
				}
				h1 {
					font-size: 24px !important;
				}
				h2 {
					font-size: 20px !important;
				}
				h3 {
					font-size: 18px !important;
				}
				p,
				td {
					font-size: 14px !important;
				}
				table {
					width: 100% !important;
				}
			}
		</style>
	</head>
	<body
		style="
			font-family: Arial, sans-serif;
			margin: 0;
			padding: 20px;
			background-color: #f4f4f4;
		"
	>
		<div
			class="container"
			style="
				max-width: 600px;
				margin: 0 auto;
				background-color: #fff;
				padding: 20px;
				border-radius: 8px;
				box-shadow: 0 0 10px rgba(0, 0, 0, 0.1);
			"
		>
			<h1 style="color: #333; text-align: center; font-size: 28px">Space U</h1>
			<h2 style="color: #555; text-align: center; font-size: 24px">
				Your space at SpaceU is Reserved
			</h2>
			<p style="color: #666; font-size: 16px">Dear <%= customerName %>,</p>
			<p style="color: #666; font-size: 16px">
				Thank you for booking with SpaceU! We're excited to host you and ensure
				your session is a success.
			</p>
			<h3 style="color: #333; font-size: 20px">
				Here's a summary of your booking:
			</h3>
			<% reservations.forEach(reservation => { %>
			<table
				style="width: 100%; border-collapse: collapse; margin-bottom: 20px"
			>
				<tr>
					<td
						style="
							padding: 10px;
							border: 1px solid #ddd;
							background-color: #f9f9f9;
							font-weight: bold;
						"
					>
						Space:
					</td>
					<td style="padding: 10px; border: 1px solid #ddd">
						<%= reservation.space.name %>
					</td>
				</tr>
				<tr>
					<td
						style="
							padding: 10px;
							border: 1px solid #ddd;
							background-color: #f9f9f9;
							font-weight: bold;
						"
					>
						Date:
					</td>
					<td style="padding: 10px; border: 1px solid #ddd">
						<%= reservation.date %>
					</td>
				</tr>
				<tr>
					<td
						style="
							padding: 10px;
							border: 1px solid #ddd;
							background-color: #f9f9f9;
							font-weight: bold;
						"
					>
						Time:
					</td>
					<td style="padding: 10px; border: 1px solid #ddd">
						<%= reservation.start_time %> - <%= reservation.end_time %>
					</td>
				</tr>
				<tr>
					<td
						style="
							padding: 10px;
							border: 1px solid #ddd;
							background-color: #f9f9f9;
							font-weight: bold;
						"
					>
						Duration:
					</td>
					<td style="padding: 10px; border: 1px solid #ddd">
						<%= reservation.duration %> hour(s)
					</td>
				</tr>
			</table>
			<% }) %>

			<p style="color: #666; font-size: 16px">
				Arrive on time to make the most of your session. If you have any
				questions, please let us know. You can reach us on
				<a
					href="tel:<%= contactPhone %>"
					style="color: #007bff; text-decoration: none"
					><%= contactPhone %></a
				>
				or email us at
				<a
					href="mailto:<%= contactEmail %>"
					style="color: #007bff; text-decoration: none"
					><%= contactEmail %></a
				>.
			</p>
			<p style="color: #666; text-align: center; font-size: 16px">
				Best regards,
			</p>
			<p style="color: #666; text-align: center; font-size: 16px">
				<%= contactAddress  %>
			</p>
		</div>
	</body>
</html>
